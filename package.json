{
  "name": "typescript-transform-paths",
  "version": "4.0.0",
  "description": "Transforms module resolution paths using TypeScript path mapping and/or custom paths",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./plugins/nx": "./dist/plugins/nx.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "compile": "tsc",
    "build": "tsdown",
    "test": "yarn test/ test",
    "release": "changelogen --release --push",
    "--------------": "",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "rm -rf \"**/dist\"",
    "clean:all": "yarn clean && rm -rf node_modules \"**/node_modules\" \"**/yarn.lock\" yarn.lock",
    "reset": "yarn clean:all && yarn install && yarn build",
    "-------------- ": "",
    "prepack": "yarn build",
    "knip": "knip"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/plugins/*.ts"
    ],
    "exports": true,
    "unbundle": false,
    "dts": true,
    "format": "esm",
    "clean": true
  },
  "keywords": [
    "typescript",
    "transform",
    "transformer",
    "plugin",
    "path",
    "paths",
    "virtual directory",
    "import",
    "require"
  ],
  "homepage": "https://github.com/LeDDGroup/typescript-transform-paths#readme",
  "bugs": {
    "url": "https://github.com/LeDDGroup/typescript-transform-paths/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeDDGroup/typescript-transform-paths.git"
  },
  "license": "MIT",
  "contributors": [
    "Daniel Perez",
    "Ron S. (https://twitter.com/Ron)"
  ],
  "devDependencies": {
    "@tsconfig/bases": "^1.0.16",
    "@types/node": "^25.0.3",
    "@types/ts-expose-internals": "npm:ts-expose-internals@4.9.5",
    "changelogen": "^0.6.2",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "ts-patch": "^4.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "dependencies": {
    "minimatch": "^10.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "inlinedDependencies": {
    "ts-patch": "3.3.0"
  }
}
